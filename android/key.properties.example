# Configuración del keystore para firmar la app
# Copia este archivo a key.properties y completa los valores

# Ruta al archivo keystore (.jks o .keystore)
storeFile=../path/to/your-keystore.jks

# Password del keystore
storePassword=tu_password_del_keystore

# Alias de la clave en el keystore
keyAlias=tu_key_alias

# Password de la clave
keyPassword=tu_password_de_la_clave

# INSTRUCCIONES:
# 1. Copia este archivo: cp key.properties.example key.properties
# 2. Edita key.properties con tus valores reales
# 3. Asegúrate de que el keystore tenga el SHA1: 17:A5:BF:96:A8:50:A8:1F:EA:51:0E:47:21:9E:C2:D2:F7:10:78:54
# 4. Para verificar el SHA1 de un keystore:
#    keytool -list -v -keystore /ruta/al/keystore.jks
